{
  "name": "ltv-logo-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LTV animated logo for vanilla JS/TS, Vue and React",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter 'ltv-logo-js' build && bun run --filter 'ltv-logo-vue' --filter 'ltv-logo-react' build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.scripts.json",
    "test": "bun test",
    "check": "bun run format:check && bun run build && bun run typecheck && bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:js": "bun --cwd packages/ltv-logo-js dev",
    "dev:vue": "bun --cwd packages/ltv-logo-vue dev",
    "dev:react": "bun --cwd packages/ltv-logo-react dev",
    "version:bump": "bun scripts/bump-version.ts",
    "playground": "bun run --filter ltv-logo-js build && bun scripts/playground.ts",
    "brand": "bun scripts/brand-assets.ts"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.4.4",
    "opentype.js": "2.0.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
